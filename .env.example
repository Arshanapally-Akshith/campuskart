# Local infrastructure credentials for docker-compose (mongo, redis, mongo-express).
# Copy to .env and adjust if needed. Not used in production — see apps/api/.env.example
# and apps/web/.env.example for per-app runtime config.

MONGO_INITDB_ROOT_USERNAME=campuskart
MONGO_INITDB_ROOT_PASSWORD=campuskart_dev_password
MONGO_PORT=27017

REDIS_PORT=6379

MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin
