{
  "name": "@campuskart/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@campuskart/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^8.24.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "~5.9.3"
  }
}
