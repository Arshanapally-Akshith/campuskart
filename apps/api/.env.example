NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Matches the credentials in the root .env.example used by docker-compose.
MONGO_URI=mongodb://campuskart:campuskart_dev_password@localhost:27017/campuskart?authSource=admin
REDIS_URL=redis://localhost:6379

# Symmetric secret for signing access JWTs. Generate a real one for anything
# beyond local dev, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev_only_change_me_dev_only_change_me

# From your Cloudinary dashboard (console.cloudinary.com). A free account is
# enough for dev. Without real values, /api/uploads/sign still runs and
# produces a syntactically valid signature, but real uploads to Cloudinary
# will fail — see docs/PHASE3_NOTES.md.
CLOUDINARY_CLOUD_NAME=dev_only_change_me
CLOUDINARY_API_KEY=dev_only_change_me
CLOUDINARY_API_SECRET=dev_only_change_me
