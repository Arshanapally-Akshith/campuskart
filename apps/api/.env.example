NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Matches the credentials in the root .env.example used by docker-compose.
MONGO_URI=mongodb://campuskart:campuskart_dev_password@localhost:27017/campuskart?authSource=admin
REDIS_URL=redis://localhost:6379
